# .gitignore for Power Platform Agent Workspace
# Auto-generated by 'pp workspace init'

# Engine-managed state (deployment history, cache, logs)
.pp/

# Python
__pycache__/
*.py[cod]
*$py.class
*.so

# Environment variables
# Ignore every .env variant (.env.local, .env.prod, …) but KEEP the committed
# credential template — it contains no secrets and is the only onboarding hint
# for a fresh clone. Without the negation below, `.env.*` swallows
# `.env.example`, it never reaches the repo, and `pp workspace init` crashes
# while reading it (framework_power/cli.py).
.env
.env.*
!.env.example

# IDE
.vscode/
.idea/
*.swp

# OS
.DS_Store
Thumbs.db

# Build artifacts
dist/
build/
*.egg-info/
