# Power Platform Agent - Workspace Environment Variables
#
# This file contains Dataverse credentials specific to this workspace.
# Copy to .env and fill in your actual values.
#
# LLM API keys go in ~/.power-platform-agent/.env (user-level, cross-project).
#
# !! WARNING: Do NOT commit .env to git. It contains real secrets. !!

# ================================
# Dataverse Authentication (per-workspace)
# ================================

# DEV environment credentials
DEV_CLIENT_ID=your-client-id-here
DEV_CLIENT_SECRET=your-client-secret-here
DEV_TENANT_ID=your-tenant-id-here

# TEST environment credentials (optional)
# TEST_CLIENT_ID=your-test-client-id
# TEST_CLIENT_SECRET=your-test-client-secret
# TEST_TENANT_ID=your-test-tenant-id

# PROD environment credentials (optional)
# PROD_CLIENT_ID=your-prod-client-id
# PROD_CLIENT_SECRET=your-prod-client-secret
# PROD_TENANT_ID=your-prod-tenant-id
