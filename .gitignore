# ============================================================
# Workspace Data (not tracked by git — engine repo only)
# ============================================================
# This repo is the ENGINE source. Workspace data (metadata,
# configs, webresources, plugins, sources) lives in workspace
# directories like ninebot-project/ and is NOT tracked here.
#
# Each workspace has its own .gitignore (created by `pp workspace init`).
# Workspaces manage their own git lifecycle independently.

# Workspace directories (any directory containing pp-workspace.yaml)
*/pp-workspace.yaml
ninebot-project/

# Legacy workspace data at root (no longer tracked — migrated to workspace dirs)
metadata_py/
metadata/
config/
webresources/
plugins/
.pp-local/
.workbuddy/

# Data dictionary temp files (generated per-workspace)
docs/data_dictionary/*
docs/data_dictionary/*.md
!docs/data_dictionary/CLAUDE.md

# Documentation agent suggestion files
*.suggest

# Logs
*.log
logs/

# Test coverage
htmlcov/
.tox/
.coverage
.coverage.*
.cache
.pytest_cache/

# Scratch/probe files (one-off scripts & reports with local machine paths)
.tmp*
.tem*
# Office lock files
~$*
